{
  "name": "homebridge-zz-zengge-ble-strips",
  "displayName": "Zigzag Zengge BLE Strips",
  "version": "1.0.0",
  "private": true,
  "description": "Homebridge plugin to control Zengge LED strip over BLE",
  "main": "dist/index.js",
  "keywords": [
    "homebridge-plugin",
    "zengge",
    "ledstrip",
    "ble"
  ],
  "peerDependencies": {
    "homebridge": ">2.0.0-beta.0"
  },
  "engines": {
    "node": "18.x",
    "homebridge": "^1.8.0 || ^2.0.0-beta.0"
  },
  "dependencies": {
    "@types/node": "^12.11.7",
    "@abandonware/noble": "^1.9.2-26",
    "typescript": "^5.6.3",
    "@types/ws": "^6.0.3",
    "nodemon": "^1.19.4",
    "tslint": "^5.20.0"
    },
  "scripts": {
    "build": "tsc && cp scripts/bleDispatcher.py dist/",
    "watch": "nodemon",
    "prepublishOnly": "npm i --package-lock-only && npm audit && npm run build",
    "postinstall": "npm run build && node scripts/postInstall.js"
  }
}